<?xml version="1.0" encoding="UTF-8"?>
<!-- Proyecto Maven: define dependencias, compilación Java 17 y plugin de Spring Boot para el microservicio de órdenes de mascotas -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion> <!-- Versión del modelo POM requerida por Maven -->

    <!-- Hereda versiones de dependencias y configuración por defecto de Spring Boot 3.2.3 -->
    <parent>
        <groupId>org.springframework.boot</groupId> <!-- Grupo del proyecto padre de Spring Boot -->
        <artifactId>spring-boot-starter-parent</artifactId> <!-- Artefacto padre que gestiona versiones -->
        <version>3.2.3</version> <!-- Versión de Spring Boot utilizada en el proyecto -->
        <relativePath/> <!-- Busca el parent en el repositorio Maven, no en el filesystem local -->
    </parent>

    <!-- Coordenadas del artefacto que genera este proyecto -->
    <groupId>com.duoc</groupId> <!-- Grupo de la organización: Duoc UC -->
    <artifactId>mascotas-ordenes</artifactId> <!-- Nombre del artefacto (JAR resultante) -->
    <version>0.0.1-SNAPSHOT</version> <!-- Versión en desarrollo (SNAPSHOT = no estable) -->
    <name>mascotas-ordenes</name> <!-- Nombre legible del proyecto -->
    <description>Microservicio de gestión de órdenes de productos para mascotas - Duoc UC</description> <!-- Descripción del propósito del microservicio -->

    <!-- Propiedades globales del build (versión del lenguaje Java y versión del driver Oracle) -->
    <properties>
        <java.version>17</java.version> <!-- Compila el código fuente con Java 17 (LTS) -->
        <oracle.jdbc.version>23.3.0.23.09</oracle.jdbc.version> <!-- Versión del driver Oracle JDBC compatible con Autonomous Database -->
    </properties>

    <!-- Librerías necesarias en tiempo de compilación y ejecución -->
    <dependencies>
        <!-- REST: Tomcat embebido, Jackson JSON, Spring MVC para exponer endpoints HTTP -->
        <dependency>
            <groupId>org.springframework.boot</groupId> <!-- Grupo de Spring Boot -->
            <artifactId>spring-boot-starter-web</artifactId> <!-- Starter web: incluye servidor y framework MVC -->
        </dependency>

        <!-- JPA/Hibernate: mapeo objeto-relacional (ORM) para persistir entidades en Oracle -->
        <dependency>
            <groupId>org.springframework.boot</groupId> <!-- Grupo de Spring Boot -->
            <artifactId>spring-boot-starter-data-jpa</artifactId> <!-- Incluye Hibernate y Spring Data JPA (JpaRepository) -->
        </dependency>

        <!-- Validación: Bean Validation (Hibernate Validator) para validar datos de entrada en la API -->
        <dependency>
            <groupId>org.springframework.boot</groupId> <!-- Grupo de Spring Boot -->
            <artifactId>spring-boot-starter-validation</artifactId> <!-- Starter de validación: @NotBlank, @Email, @Min, etc. -->
        </dependency>

        <!-- Seguridad: autenticación HTTP Basic, autorización por roles y configuración CORS -->
        <dependency>
            <groupId>org.springframework.boot</groupId> <!-- Grupo de Spring Boot -->
            <artifactId>spring-boot-starter-security</artifactId> <!-- Starter de Spring Security para proteger los endpoints REST -->
        </dependency>

        <!-- Driver Oracle JDBC: conexión a Oracle Autonomous Database desde Java 17 -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId> <!-- Grupo oficial de Oracle en Maven Central -->
            <artifactId>ojdbc11</artifactId> <!-- Driver JDBC para Java 11+ (compatible con Java 17) -->
            <version>${oracle.jdbc.version}</version> <!-- Versión centralizada en la propiedad definida arriba -->
        </dependency>

        <!-- Librerías PKI de Oracle: soporte para Wallet mTLS de Autonomous Database -->
        <!-- Desde ojdbc 21c+, oraclepki.jar ya incluye osdt_core y osdt_cert, por eso NO se agregan por separado -->
        <dependency>
            <groupId>com.oracle.database.security</groupId> <!-- Grupo de librerías de seguridad de Oracle -->
            <artifactId>oraclepki</artifactId> <!-- Implementación PKI propia de Oracle para leer cwallet.sso / ewallet.p12 -->
            <version>${oracle.jdbc.version}</version> <!-- Se alinea con la versión del driver -->
        </dependency>

        <!-- JUnit 5, Mockito, Spring Test: solo se usa al compilar/ejecutar tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId> <!-- Grupo de Spring Boot -->
            <artifactId>spring-boot-starter-test</artifactId> <!-- Starter de pruebas unitarias e integración -->
            <scope>test</scope> <!-- Solo disponible en fase de test, no se empaqueta en el JAR final -->
        </dependency>

        <!-- Seguridad: utilidades de testing para Spring Security -->
        <dependency>
            <groupId>org.springframework.security</groupId> <!-- Grupo de Spring Security -->
            <artifactId>spring-security-test</artifactId> <!-- Soporte de @WithMockUser y utilidades para pruebas de seguridad -->
            <scope>test</scope> <!-- Solo disponible en la fase de test -->
        </dependency>
    </dependencies>

    <!-- Plugins de Maven: empaquetado ejecutable (fat JAR) con java -jar -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId> <!-- Plugin oficial de Spring Boot -->
                <artifactId>spring-boot-maven-plugin</artifactId> <!-- Genera un JAR ejecutable con todas las dependencias -->
            </plugin>
        </plugins>
    </build>

</project>
